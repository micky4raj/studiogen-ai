# --- Anthropic (Copywriting + Background Prompt Generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Replicate (masked inpainting for studio shots) ---
REPLICATE_API_TOKEN=r8_xxxx
# Must be a masked inpainting model (takes `image` + `mask`), not a plain
# img2img/text-to-image model — see lib/mask.ts and lib/replicate.ts for why.
REPLICATE_MODEL_VERSION=stability-ai/stable-diffusion-inpainting

# --- Background removal (choose one) ---
BG_REMOVAL_PROVIDER=cloudinary   # or "rembg" for self-hosted
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx
REMBG_ENDPOINT=http://localhost:7000/remove   # only if self-hosted rembg service

# --- Supabase (Storage + DB for users/credits/jobs) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx   # server-side only, never expose to client
SUPABASE_STORAGE_BUCKET=product-photos

# --- Stripe (Subscriptions + credit packs) ---
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Recurring Price IDs from the Stripe dashboard — subscription line items can't
# use inline price_data the way one-time credit packs do. Required for
# /api/subscribe; the "pro"/"studio" plans in lib/credits.ts won't work without these.
STRIPE_PRO_PRICE_ID=price_xxxx
STRIPE_STUDIO_PRICE_ID=price_xxxx

# --- Razorpay (alt payment rail, e.g. for India) ---
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# --- Inngest (background job queue for the image pipeline) ---
# Local dev: run `npx inngest-cli@latest dev` alongside `npm run dev` — no keys needed.
# Production: get these from the Inngest dashboard after connecting your deployed app.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Upstash Redis (rate limiting) ---
# Without these, rate limiting falls back to an in-memory limiter that is NOT
# safe across multiple serverless instances — set these before production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Observability (optional) ---
# Without this, lib/logger.ts logs structured JSON to stdout only — fine for
# local dev, but set this before production so errors actually reach you.
SENTRY_DSN=
